# 复制为 .env.ecs-web 后按需修改（已被 .gitignore 忽略）
# cp .env.ecs-web.example .env.ecs-web
#
# SSH 连接复用 server/.env.ecs-upload，此处仅配置前端部署项。

# Nginx root（与 /etc/nginx/conf.d/app.conf 中 root 一致）
ECS_WEB_REMOTE_DIR=/var/www/app/dist

# /var/www 下目录通常需 sudo 写入；auto = 路径以 /var/www 开头时自动启用
ECS_WEB_USE_SUDO=auto

# 构建模式：ecs = 使用 .env.ecs（VITE_API_BASE 留空，走 Nginx /api 反代）
# ECS_WEB_BUILD_MODE=ecs
