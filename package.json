{
  "name": "warehouse-anagement",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "pnpm --dir server run dev",
    "dev:worker": "pnpm --dir server run worker:dev",
    "dev:backend": "concurrently -k -n api,worker \"pnpm --dir server run dev\" \"pnpm --dir server run worker:dev\"",
    "dev:all": "concurrently -k -n api,worker,web \"pnpm --dir server run dev\" \"pnpm --dir server run worker:dev\" \"pnpm dev\"",
    "build": "tsc -b && vite build",
    "ecs:upload-web": "bash scripts/ecs-upload-web.sh",
    "ecs:deploy-web": "bash scripts/ecs-upload-web.sh --reload-nginx",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@antv/g2": "^5.4.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@mui/material": "^9.0.0",
    "@rive-app/canvas": "^2.38.1",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "antd": "^6.3.7",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.20",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "i18next": "^26.3.4",
    "idb": "^8.0.3",
    "lucide-react": "^0.539.0",
    "react": "^19.2.5",
    "react-activation": "^0.13.4",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.14.2",
    "react-vant": "^3.3.5",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/google.maps": "^3.65.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.12",
    "tailwindcss": "3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
