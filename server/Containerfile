# Build context 必须是仓库根（含 server/ 与 shared/）。
# compose: context: ..  dockerfile: server/Containerfile
FROM node:22-alpine
WORKDIR /workspace/server

# 与 lockfile v6 兼容的 pnpm 版本
RUN corepack enable && corepack prepare pnpm@8.15.9 --activate

COPY server/package.json server/pnpm-lock.yaml server/drizzle.config.ts ./
RUN pnpm install --frozen-lockfile --prod

COPY server/src ./src
# 相对路径 ../../../shared（自 src/routes）解析到 /workspace/shared
COPY shared /workspace/shared

ENV NODE_ENV=production
ENV PORT=8787
ENV HOST=0.0.0.0

RUN addgroup -S app && adduser -S app -G app
USER app

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8787)+'/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["sh", "-c", "pnpm db:migrate && pnpm start"]
