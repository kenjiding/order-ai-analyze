{
  "name": "@warehouse-anagement/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:order-analyze": "tsx --test src/orderAnalyze/orderAnalyze.test.ts",
    "test:order-analyze-regression": "tsx src/orderAnalyze/regression/regressionCli.ts",
    "podman:build": "podman build -t warehouse-server:latest -f Containerfile .",
    "podman:up": "podman compose up -d --build",
    "podman:down": "podman compose down"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "openai": "^6.37.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.12.2",
    "typescript": "~6.0.2"
  }
}
