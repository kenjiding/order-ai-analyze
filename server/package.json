{
  "name": "@warehouse-anagement/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker:dev": "tsx watch src/workerIndex.ts",
    "worker:start": "tsx src/workerIndex.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:init": "bash scripts/init-local-db.sh",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json",
    "test:order-analyze": "tsx --test src/orderAnalyze/orderAnalyze.test.ts src/orderAnalyze/driverVendorEnrich.test.ts",
    "test:feishu-card": "tsx --test src/feishu/buildFleetRichMessageCard.test.ts",
    "test:container-reconcile": "tsx --test src/containerManagement/reconcileNet.test.ts",
    "test:container-access": "tsx --test src/containerManagement/access.test.ts",
    "test:container-card": "tsx --test src/feishu/buildContainerTransferCard.test.ts",
    "test:dispatch-alarm-card": "tsx --test src/feishu/buildDispatchAlarmCard.test.ts",
    "test:exit-alarm-card": "tsx --test src/feishu/buildExitAlarmCard.test.ts",
    "test:vendor-metrics": "tsx --test src/vendorAnalysis/metricsCatalog.test.ts",
    "test:vendor-ranking": "tsx --test src/vendorAnalysis/rankingScore.test.ts",
    "test:vendor-region-map": "tsx --test src/vendorRegionMap/trendAggregate.test.ts",
    "test:vendor-scope": "tsx --test src/vendorAnalysis/supplierScope.test.ts src/vendorAnalysis/before11Aggregate.test.ts src/imile/before11Exit.test.ts",
    "test:dispatch-performance": "tsx --test src/dispatch24hStats/settledArrivalDates.test.ts src/dispatch24hStats/settleTime.test.ts src/dispatch24hStats/settleLock.test.ts src/dispatch24hStats/aggregateCells.test.ts src/dispatch24hStats/performanceTree.test.ts src/vendorAnalysis/dispatch24hTerminal.test.ts src/vendorAnalysis/aggregate.test.ts",
    "test:scheduled-push": "tsx --test src/jobs/scheduledDueSlots.test.ts",
    "test:order-analyze-regression": "tsx src/orderAnalyze/regression/regressionCli.ts",
    "podman:build": "podman build -t warehouse-server:latest -f Containerfile .",
    "podman:up": "podman compose up -d --build",
    "podman:down": "podman compose down",
    "ecs:upload": "bash scripts/ecs-upload.sh",
    "ecs:deploy": "bash scripts/ecs-upload.sh --deploy"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "openai": "^6.37.0",
    "postgres": "^3.4.9",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.2",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6.0.2"
  }
}
